# ==============================================================================
# PERÍCIAMED - VARIÁVEIS DE AMBIENTE (HostGator / Produção / AI Studio)
# ==============================================================================

# 1. Chave da API do Google Gemini (Obrigatória no servidor para minutas e laudos)
# No AI Studio: Injetada automaticamente nos Segredos.
# Na HostGator (cPanel > Setup Node.js App > Environment variables):
# Extraia sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# Alternativa aceita caso você nomeie como GEMINI_LIVE_API_KEY na HostGator:
GEMINI_LIVE_API_KEY="AIzaSy..."

# 2. Ambiente de Execução (HostGator)
# Na HostGator, defina como 'production' no cPanel
NODE_ENV="production"

# 3. Porta do Servidor (HostGator / Local)
# Na HostGator com Passenger, a porta ou socket é atribuída automaticamente pelo cPanel.
# Para testes locais ou VPS:
PORT="3000"

# 4. URL Pública da Aplicação (Opcional)
# Ex: https://periciamed.com.br
APP_URL="https://meudominio.com.br"
